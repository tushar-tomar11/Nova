# Template for Vercel Project Settings → Environment Variables.
# Copy to .env.local for local use. Do not put real secrets in git.

# Mainnet Solana RPC — set this in Vercel too. Never commit API keys.
# Helius: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# QuickNode: https://YOUR_ENDPOINT.solana-mainnet.quiknode.pro/YOUR_KEY/
# Triton: https://YOUR_ENDPOINT.rpcpool.com/YOUR_KEY
NEXT_PUBLIC_MAINNET_RPC=https://api.mainnet-beta.solana.com

# Legacy alias; ignored when NEXT_PUBLIC_MAINNET_RPC is set
NEXT_PUBLIC_ENDPOINT=

# Optional Triton RPCPool token (backup connection only)
NEXT_PUBLIC_TRITON_TOKEN=

# Sentry DSN (empty disables Sentry)
NEXT_PUBLIC_SENTRY_DSN=

# Optional Sentry source-map upload at build
SENTRY_AUTH_TOKEN=

# BirdEye API (optional; code has a fallback)
NEXT_PUBLIC_BIRDEYE_API_KEY=

# Contentful CMS
NEXT_PUBLIC_CONTENTFUL_SPACE_ID=
NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=

# Set to 1 to disable geoblock on mainnet
NEXT_PUBLIC_DISABLE_GEOBLOCK=
